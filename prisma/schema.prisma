generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Yacht {
  id        Int      @id @default(autoincrement())
  name      String
  marina    String?
  berth     String?
  chefName  String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String?
  unit      String?
  price     Float?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]
}

model Order {
  id            Int          @id @default(autoincrement())
  yachtId       Int
  status        String       @default("pending")
  deliveryAt    DateTime?
  notes         String?
  subtotal      Float?
  vat           Float?
  total         Float?
  paymentStatus String       @default("pending")
  ticketSent    Boolean      @default(false)
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  yacht         Yacht        @relation(fields: [yachtId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  events        OrderEvent[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Float
  actualWeight Float?
  customPrice  Float?
  lineTotal    Float?
  notes        String?

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  type      String
  message   String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
